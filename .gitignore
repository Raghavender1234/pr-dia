# ==========================================
# OpenLMS Git Ignore Configuration
# ==========================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual Environments
venv/
env/
ENV/
.venv/

# Environment Variables & Local Secrets (NEVER COMMIT SENSITIVE DATA)
.env
*.env
env.txt
secrets.json
google_credentials*.json

# Databases & Local SQLite instances
*.db
*.sqlite
*.sqlite3
app.db
instance/

# Flask & Session Data
flask_session/
logs/
*.log

# File Uploads (Ignore user uploaded media, but keep folder structure)
app/static/uploads/*
!app/static/uploads/.gitkeep
app/static/uploads/generated_questions/*
!app/static/uploads/generated_questions/.gitkeep

# Node & Frontend dependencies
node_modules/
package-lock.json

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/

# IDE & OS-specific files
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
Desktop.ini

# Build & Distribution
build/
dist/
*.egg-info/

# Local Desktop Bot / Launchers (kept local on user PC, not tracked in git)
UPSC_ESE_Bot.py
Start_UPSC_ESE_Bot.bat
create_desktop_shortcut.py

