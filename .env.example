# ==============================================================================
# OpenLMS - Environment Configuration Template
# Copy this file to '.env' and update values for your environment.
# ==============================================================================

# --- Core Flask Settings ---
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=true
# Generate a secure secret key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-this-with-a-secure-random-secret-key
JWT_SECRET_KEY=replace-this-with-a-secure-jwt-secret-key
JWT_ACCESS_TOKEN_EXPIRES_HOURS=24
FRONTEND_URL=http://127.0.0.1:5000

# --- Database Configuration ---
# Default: Local SQLite database (Zero external setup required)
DATABASE_URL=sqlite:///app.db
# For Production PostgreSQL:
# DATABASE_URL=postgresql://username:password@localhost:5432/openlms_db

# --- Optional AI Engine (OpenAI API) ---
# Required for AI Question Generation and Conceptual Explanations
OPENAI_API_KEY=your-openai-api-key-here
# Optional Gemini API Key
GEMINI_API_KEY=your-gemini-api-key-here

# --- Optional Cloud File Storage (AWS S3) ---
# If left blank, uploads are automatically saved locally in app/static/uploads/
S3_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# --- Optional OAuth2 Authentication (Google Sign-In) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Optional Payment Gateway (Razorpay) ---
# Used for institute subscription plans in multi-tenant mode
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
